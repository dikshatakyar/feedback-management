    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "node-sqlite3-wasm": "^0.8.61",
    "zod": "^4.6.7"
  }
}
